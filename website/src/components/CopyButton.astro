---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<button
  class="copy-btn ml-auto shrink-0 rounded p-1.5 text-text-muted transition-colors hover:bg-bg-elevated hover:text-text-primary"
  data-copy={text}
  aria-label="Copy to clipboard"
  type="button"
>
  <!-- Copy icon -->
  <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
  </svg>
  <!-- Check icon (shown after copy) -->
  <svg class="check-icon hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"/>
  </svg>
</button>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.copy-btn') as HTMLButtonElement | null;
    if (!btn) return;

    const text = btn.dataset.copy;
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const copyIcon = btn.querySelector('.copy-icon') as SVGElement;
      const checkIcon = btn.querySelector('.check-icon') as SVGElement;
      copyIcon.classList.add('hidden');
      checkIcon.classList.remove('hidden');
      setTimeout(() => {
        copyIcon.classList.remove('hidden');
        checkIcon.classList.add('hidden');
      }, 1500);
    });
  });
</script>
