---
const base = import.meta.env.BASE_URL;

// Fetch GitHub stars at build time
let stars = 0;
try {
  const res = await fetch('https://api.github.com/repos/yogirk/tgcp', {
    headers: { 'Accept': 'application/vnd.github.v3+json' },
  });
  if (res.ok) {
    const data = await res.json();
    stars = data.stargazers_count ?? 0;
  }
} catch {}
---

<header class="sticky top-0 z-50 border-b border-border-subtle/50 bg-bg-deep/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-3">
    <!-- Wordmark -->
    <a href={base} class="flex items-center gap-1 text-xl font-bold tracking-tight no-underline">
      <span class="text-blue">T</span><span class="text-red">G</span><span class="text-yellow">C</span><span class="text-green">P</span>
    </a>

    <div class="flex items-center gap-3">
      <!-- GitHub + Stars -->
      <a
        href="https://github.com/yogirk/tgcp"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-full border border-border-subtle px-3 py-1.5 text-sm text-text-secondary transition-colors hover:border-text-muted hover:text-text-primary"
        aria-label="Star on GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-yellow" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        {stars > 0 && <span class="font-medium">{stars}</span>}
      </a>

      <!-- Install pill -->
      <a
        href="#install"
        class="rounded-full bg-blue/15 px-4 py-1.5 text-sm font-medium text-blue transition-colors hover:bg-blue/25"
      >
        Install
      </a>
    </div>
  </nav>
</header>
