---
import AsciiLogo from './AsciiLogo.astro';
import TerminalWindow from './TerminalWindow.astro';
---

<section class="px-6 py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
    <!-- Left: ASCII + tagline -->
    <div class="animate-fade-up">
      <AsciiLogo />
      <h1 class="mt-6 text-3xl font-bold leading-tight md:text-4xl lg:text-5xl">
        Your GCP terminal<br />
        <span class="text-text-secondary">companion.</span>
      </h1>
      <p class="mt-4 max-w-lg text-lg text-text-secondary">
        A fast, keyboard-driven TUI for observing and managing Google Cloud Platform resources. Inspired by k9s.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <code class="inline-flex items-center gap-2 rounded-lg border border-border-subtle bg-bg-surface px-4 py-2.5 font-mono text-sm">
          <span class="text-text-muted">$</span>
          <span>brew tap yogirk/tgcp && brew install tgcp</span>
        </code>
      </div>
    </div>

    <!-- Right: Terminal with TUI preview -->
    <div class="animate-fade-up" style="animation-delay: 0.15s">
      <TerminalWindow>
        <!-- Install command -->
        <div class="animate-reveal-line" style="animation-delay: 0.3s">
          <span class="text-green">&#x276F; </span><span>brew tap yogirk/tgcp && brew install tgcp</span>
        </div>
        <div class="animate-reveal-line text-text-secondary" style="animation-delay: 0.65s">
          &#x1F37A; tgcp 0.2.0 installed
        </div>
        <div class="animate-reveal-line" style="animation-delay: 1.0s">
          <span class="text-green">&#x276F; </span><span>tgcp</span>
        </div>

        <!-- TUI Preview (appears as one block) -->
        <div class="animate-fade-up mt-4" style="animation-delay: 1.4s">
          <!-- Info bar -->
          <div class="border border-border-subtle rounded px-2.5 py-1.5 mb-3 flex gap-4 text-xs text-text-secondary">
            <span>&#x1F464; user@company.com</span>
            <span>&#x1F4C1; my-gcp-project</span>
          </div>

          <!-- Services panel — matches new fuzzy-filter list layout -->
          <div class="border border-blue/40 rounded px-3 py-2.5">
            <div class="mb-2">
              <span class="bg-text-secondary text-bg-deep text-xs px-1.5 py-0.5 rounded-sm font-bold">Services</span>
            </div>
            <!-- Filter bar -->
            <div class="mb-2 text-xs text-text-muted">
              <span>Filter:</span>
              <span class="ml-1">Press / to filter</span>
              <span class="ml-3">Items: 21</span>
            </div>
            <!-- Flat service list with category headers -->
            <div class="space-y-0.5 text-xs leading-relaxed">
              <div><span class="text-blue">&#x25B8; &#x25C9;  Overview (Command Center)</span></div>
              <div class="text-text-muted font-bold uppercase tracking-wider text-[10px] pt-0.5">Compute</div>
              <div class="pl-2 text-text-secondary">&#x2699;  Compute Engine (GCE)</div>
              <div class="pl-2 text-text-secondary">&#x2638;  Kubernetes Engine (GKE)</div>
              <div class="pl-2 text-text-secondary">&#x25B7;  Cloud Run</div>
              <div class="text-text-muted font-bold uppercase tracking-wider text-[10px] pt-0.5">Storage</div>
              <div class="pl-2 text-text-secondary">&#x25A4;  Cloud Storage (GCS)</div>
              <div class="pl-2 text-text-secondary">&#x25D4;  Disks (Block Storage)</div>
              <div class="text-text-muted font-bold uppercase tracking-wider text-[10px] pt-0.5">Databases</div>
              <div class="pl-2 text-text-secondary">&#x26C1;  Cloud SQL</div>
              <div class="pl-2 text-text-secondary">&#x2B21;  Spanner</div>
              <div class="pl-2 text-text-secondary">&#x25A6;  Bigtable</div>
              <div class="text-text-muted text-[10px] pl-2">&#x2193; more</div>
            </div>
          </div>

          <!-- Keybinding bar -->
          <div class="mt-2.5 flex flex-wrap justify-center gap-x-3 gap-y-0.5 text-[10px] text-text-muted">
            <span>&#x2191;/&#x2193; navigate</span>
            <span>/ filter</span>
            <span>Enter select</span>
            <span>? help</span>
          </div>
        </div>
      </TerminalWindow>
    </div>
  </div>
</section>
