---
const cards = [
  {
    title: '19+ GCP Services',
    color: 'blue',
    description: 'Compute, databases, storage, analytics, networking, security, and observability — all from your terminal.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="m7 8 3 3-3 3"/><line x1="13" y1="14" x2="17" y2="14"/></svg>`,
  },
  {
    title: 'Keyboard-First',
    color: 'yellow',
    description: 'Vim-style keybindings, command palette, fuzzy search — navigate GCP at the speed of thought.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01"/><path d="M10 8h.01"/><path d="M14 8h.01"/><path d="M18 8h.01"/><path d="M6 12h.01"/><path d="M10 12h.01"/><path d="M14 12h.01"/><path d="M18 12h.01"/><path d="M8 16h8"/></svg>`,
  },
  {
    title: 'Zero Config',
    color: 'green',
    description: 'Uses your existing gcloud credentials. No API keys, no setup files — just run tgcp and go.',
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
];

const colorMap: Record<string, { border: string; text: string; bg: string }> = {
  blue:   { border: 'border-blue/20', text: 'text-blue', bg: 'bg-blue/10' },
  yellow: { border: 'border-yellow/20', text: 'text-yellow', bg: 'bg-yellow/10' },
  green:  { border: 'border-green/20', text: 'text-green', bg: 'bg-green/10' },
};
---

<section class="px-6 py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {cards.map((card, i) => {
      const c = colorMap[card.color];
      return (
        <div
          class:list={[
            'animate-fade-up rounded-xl border p-6 transition-colors hover:bg-bg-surface/50',
            c.border,
          ]}
          style={`animation-delay: ${i * 0.1}s`}
        >
          <div class:list={['mb-4 inline-flex rounded-lg p-2.5', c.bg, c.text]}>
            <Fragment set:html={card.icon} />
          </div>
          <h3 class="text-lg font-semibold">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-secondary">{card.description}</p>
        </div>
      );
    })}
  </div>
</section>
