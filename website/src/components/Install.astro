---
import TerminalWindow from './TerminalWindow.astro';
import CopyButton from './CopyButton.astro';

const methods = [
  {
    label: 'macOS',
    title: 'Terminal — Homebrew',
    lines: [
      'brew tap yogirk/tgcp',
      'brew install tgcp',
    ],
    copyText: 'brew tap yogirk/tgcp && brew install tgcp',
  },
  {
    label: 'Linux',
    title: 'Terminal — curl',
    lines: [
      'curl -L https://github.com/yogirk/tgcp/releases/latest/download/tgcp_linux_amd64.tar.gz | tar -xz',
      'sudo mv tgcp /usr/local/bin/',
    ],
    copyText: 'curl -L https://github.com/yogirk/tgcp/releases/latest/download/tgcp_linux_amd64.tar.gz | tar -xz && sudo mv tgcp /usr/local/bin/',
  },
  {
    label: 'From Source',
    title: 'Terminal — go build',
    lines: [
      'git clone https://github.com/yogirk/tgcp.git',
      'cd tgcp',
      'go build -o tgcp ./cmd/tgcp',
      'sudo mv tgcp /usr/local/bin/',
    ],
    copyText: 'git clone https://github.com/yogirk/tgcp.git && cd tgcp && go build -o tgcp ./cmd/tgcp && sudo mv tgcp /usr/local/bin/',
  },
];
---

<section id="install" class="px-6 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="text-center text-2xl font-bold md:text-3xl">
      Get started in<br />
      <span class="text-text-secondary">seconds.</span>
    </h2>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {methods.map((method) => (
        <div>
          <span class="mb-3 inline-block text-sm font-medium text-text-secondary">{method.label}</span>
          <TerminalWindow title={method.title}>
            <div class="flex items-start gap-2">
              <div class="flex-1 min-w-0">
                {method.lines.map((line) => (
                  <div class="whitespace-pre-wrap break-all">
                    <span class="text-green">❯ </span>
                    <span>{line}</span>
                  </div>
                ))}
              </div>
              <CopyButton text={method.copyText} />
            </div>
          </TerminalWindow>
        </div>
      ))}
    </div>
  </div>
</section>
